# --- Local dev (default) ---
DATABASE_URL=postgresql+psycopg://postgres:yourpassword@localhost:5432/ranco_dental_dev

# --- Production (Lambda + Aurora Serverless v2 via RDS Data API) ---
# Uncomment and fill in when deploying — see docs/deployment.md.
# DATABASE_URL=postgresql+auroradataapi://:@/ranco_dental
# DB_CLUSTER_ARN=arn:aws:rds:ap-south-1:<account-id>:cluster:<cluster-name>
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:<account-id>:secret:<secret-name>

JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173